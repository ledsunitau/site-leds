<%# Aba Projetos: ações participadas (como membro) + idealizadas (ideia virou
    ação). Reusa o card de Ações. %>
<% if @acoes.any? %>
  <div class="acoes-list">
    <% @acoes.each do |a| %>
      <%= render "acoes/card", a: a %>
    <% end %>
  </div>
<% else %>
  <div class="empty-state">
    <span class="empty-mono">// nada por aqui ainda</span>
    <p>As ações que você participar ou que nascerem de uma ideia sua aparecem aqui.</p>
  </div>
<% end %>
