<%# Aba Informações: edição da conta + contas vinculadas. %>
<div class="perfil-grid">
  <section class="perfil-card">
    <h3 class="perfil-card-title">Informações da conta</h3>
    <%= form_with model: @user, url: profile_path, method: :patch, class: "perfil-form" do |f| %>
      <label class="auth-field">
        <span>Nome</span>
        <%= f.text_field :name, autocomplete: "name" %>
      </label>
      <label class="auth-field">
        <span>E-mail</span>
        <input type="email" value="<%= @user.email %>" disabled>
      </label>
      <label class="auth-field">
        <span>Foto</span>
        <%= f.file_field :foto, accept: "image/png,image/jpeg,image/webp" %>
      </label>
      <label class="auth-field">
        <span>Descrição</span>
        <%= f.text_area :bio, rows: 4, placeholder: "Conte um pouco sobre você…" %>
      </label>
      <%= f.submit "Salvar alterações", class: "btn btn-primary" %>
    <% end %>
  </section>

  <section class="perfil-card">
    <h3 class="perfil-card-title">Contas vinculadas</h3>
    <p class="perfil-card-sub">Entre mais rápido conectando suas contas.</p>
    <%= render "profiles/conta_oauth", provider: "google", provider_omni: :google_oauth2, label: "Google" %>
    <%= render "profiles/conta_oauth", provider: "discord", provider_omni: :discord, label: "Discord" %>
  </section>
</div>
