<%# Ícone de vantagem. Local `chave`. Stroke no estilo dos SVGs do site. %>
<% svg = { fill: "none", stroke: "currentColor", "stroke-width": "1.7", "stroke-linecap": "round", "stroke-linejoin": "round", viewBox: "0 0 24 24", "aria-hidden": "true" } %>
<% case chave %>
<% when "tech" %>
  <%= tag.svg(**svg) { raw('<rect x="6" y="6" width="12" height="12" rx="2"/><rect x="10" y="10" width="4" height="4"/><path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2"/>') } %>
<% when "time" %>
  <%= tag.svg(**svg) { raw('<circle cx="9" cy="8" r="3"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 5.5a3 3 0 0 1 0 5.8M18.5 20a6.5 6.5 0 0 0-3-5.2"/>') } %>
<% when "comunidade" %>
  <%= tag.svg(**svg) { raw('<path d="M12 21s-7-4.5-9.4-9A5 5 0 0 1 12 6.2 5 5 0 0 1 21.4 12c-2.4 4.5-9.4 9-9.4 9z"/>') } %>
<% when "marca" %>
  <%= tag.svg(**svg) { raw('<path d="M3 10v4a1 1 0 0 0 1 1h2l5 4V5L6 9H4a1 1 0 0 0-1 1z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/>') } %>
<% when "escala" %>
  <%= tag.svg(**svg) { raw('<path d="M4.5 15.5c-1 1-1 4-1 4s3 0 4-1M14.5 4.5c3-1 6 2 5 5-.6 1.8-6 7-9 8.2l-4-4C7.7 10.7 13.2 5.3 14.5 4.5z"/><circle cx="14.5" cy="9.5" r="1.5"/>') } %>
<% when "valor" %>
  <%= tag.svg(**svg) { raw('<path d="M3 17l6-6 4 4 7-7"/><path d="M17 8h4v4"/>') } %>
<% end %>
