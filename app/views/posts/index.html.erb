<%# Página de Novidades (Layers NOVIDADES do Figma). Tudo do banco (@posts).
    Carrossel = 3 mais recentes, FORA do frame (não muda com o filtro).
    Filtro por tipo, busca e paginação são no servidor (ver posts#index) e
    trocam só o turbo-frame de _lista. %>
<% content_for :title, "Novidades — LEDS" %>

<%= render "shared/page_bg" %>

<div class="page">
  <%= render "shared/navbar", active: "NOVIDADES" %>

  <main class="content wrap novidades-page">
    <%# FORA do turbo-frame de _lista: lá dentro, filtrar por chip apagaria o botão. %>
    <div class="novidades-head">
      <h1 class="leds-h1">Novidades</h1>
      <% if pode_escrever_novidade? %>
        <div class="btn-row">
          <%= link_to "Minhas novidades", meus_posts_path, class: "btn btn-secondary btn-sm" %>
          <%= link_to "Escrever novidade →", new_post_path, class: "btn btn-primary btn-sm" %>
        </div>
      <% end %>
    </div>

    <%# ---- Carrossel dos 3 mais recentes ---- %>
    <% if @carrossel.any? %>
      <div class="novidades-carrossel" data-controller="carrossel">
        <div class="carrossel-viewport" data-carrossel-target="viewport"
             data-action="pointerdown->carrossel#dragStart pointermove->carrossel#dragMove pointerup->carrossel#dragEnd pointercancel->carrossel#dragEnd click->carrossel#onClick dragstart->carrossel#noNativeDrag">
          <div class="carrossel-track" data-carrossel-target="track">
            <% @carrossel.each do |p| %>
              <a class="carrossel-slide" href="<%= post_path(p) %>" draggable="false" data-carrossel-target="slide">
                <%# :banner, não :card — o slide é full-bleed (1180x590 CSS) e a
                    :card tem 720 de largura. Mesma razão do .artigo-banner. %>
                <div class="carrossel-media" style="background-image:url('<%= banner_image_url(p) %>')">
                  <span class="tag solid" style="--tag-color:var(--cat-<%= p.tipo %>)"><%= p.noticia? ? "Notícia" : "Blog" %></span>
                </div>
                <div class="carrossel-info">
                  <p class="carrossel-titulo"><%= p.caller.presence || p.titulo %></p>
                  <div class="carrossel-meta">
                    <%= nome_com_emblema(p.autor, fallback: "LEDS") %>
                    <span class="meta-mono"><%= data_por_extenso(p.published_at) %></span>
                  </div>
                </div>
              </a>
            <% end %>
          </div>
        </div>
        <% if @carrossel.size > 1 %>
          <div class="carrossel-dots">
            <% @carrossel.each_with_index do |_, i| %>
              <button type="button" class="carrossel-dot <%= 'active' if i.zero? %>" data-index="<%= i %>"
                      data-carrossel-target="dot" data-action="carrossel#goTo" aria-label="Ir para o slide <%= i + 1 %>"></button>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= render "posts/lista" %>
  </main>

  <%= render "shared/footer" %>
</div>
