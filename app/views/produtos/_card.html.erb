<%# Card de produto (#LOJA/#LOJA2). Locals: `produto`, `accent` (cor da borda).
    data-categoria alimenta o filtro do cliente (#LOJA2). O "+" adiciona direto
    ao carrinho; se o produto tem tamanhos (variantes), leva ao detalhe para
    escolher o tamanho antes. %>
<article class="produto-card" style="--accent:<%= accent %>"
         data-categoria="<%= produto.categoria_id %>" data-nome="<%= produto.nome.downcase %>"
         data-preco="<%= produto.preco_atual %>" data-promo="<%= produto.em_promocao? %>"
         data-action="click->analytics#rastrear" data-evento="produto_view"
         data-meta='<%= { id: produto.id, nome: produto.nome }.to_json %>'>
  <%= link_to produto_path(produto), class: "produto-card-img", aria: { label: produto.nome } do %>
    <img src="<%= produto_imagem_url(produto) %>" alt="<%= produto.nome %>" loading="lazy">
    <% if produto.em_promocao? %><span class="promo-flag">PROMOÇÃO</span><% end %>
  <% end %>

  <div class="produto-card-body">
    <h3 class="produto-card-nome"><%= link_to produto.nome, produto_path(produto) %></h3>
    <div class="produto-card-baixo">
      <div class="produto-preco">
        <% if produto.em_promocao? %>
          <span class="preco-antigo"><%= preco_br(produto.preco) %></span>
          <span class="preco-promo"><%= preco_br(produto.preco_atual) %></span>
        <% else %>
          <span class="preco"><%= preco_br(produto.preco_atual) %></span>
        <% end %>
      </div>

      <% if produto.variantes.many? %>
        <%# várias variações (tamanhos): manda escolher no detalhe %>
        <%= link_to produto_path(produto), class: "produto-add", aria: { label: "Escolher tamanho" } do %>+<% end %>
      <% else %>
        <%# uma variação (ou "Único"): adiciona direto %>
        <button type="button" class="produto-add" aria-label="Adicionar ao carrinho"
                data-action="loja#adicionar" data-loja-produto-param="<%= produto.id %>"
                data-loja-nome-param="<%= produto.nome %>"
                data-loja-variante-param="<%= produto.variantes.first&.id %>">+</button>
      <% end %>
    </div>
  </div>
</article>
