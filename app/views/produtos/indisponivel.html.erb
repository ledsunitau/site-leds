<%# Loja desativada pela gestão: comprador vê este estado de "erro" no lugar do
    catálogo (a barra de gestão continua, para reativar). %>
<% content_for :title, "Loja indisponível — LEDS" %>

<%= render "shared/page_bg" %>

<div class="page">
  <%= render "shared/navbar", active: "LOJA" %>

  <main class="content wrap loja-off">

    <div class="loja-off-card">
      <span class="loja-off-icone" aria-hidden="true">🛒</span>
      <h1 class="leds-h2">Loja indisponível no momento</h1>
      <p>Estamos ajustando as coisas por aqui. Volte em breve — logo teremos novidades! </p>
      <%= link_to "Voltar ao início", root_path, class: "btn btn-secondary" %>
    </div>
  </main>

  <%= render "shared/footer" %>
</div>
