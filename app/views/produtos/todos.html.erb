<%# Loja — catálogo expandido (#LOJA2). Sidebar de categorias + grade paginada.
    Categoria, busca, faixa de preço, promoção e página são resolvidos no
    SERVIDOR (ver produtos#todos) e trocam só o turbo-frame de _lista.

    data-controller="loja" fica AQUI, fora do frame, porque o mesmo controller
    cuida do carrinho: os data-action dos cards e o badge do cart_fab precisam
    do mesmo escopo. Se ele descesse para dentro do frame, o badge ficaria fora
    do alcance e o contador do carrinho pararia de atualizar. %>
<% content_for :title, "Loja — produtos — LEDS" %>

<%= render "shared/page_bg" %>

<div class="page" data-controller="loja">
  <%= render "shared/navbar", active: "LOJA" %>

  <main class="content wrap loja-todos-page">

    <nav class="loja-breadcrumb"><%= link_to "← Voltar à loja", produtos_path %></nav>

    <div class="loja-todos-head">
      <h2 class="leds-h2" style="margin:0">Nossos produtos</h2>
      <%# A busca fica FORA do frame de propósito: dentro, cada tecla trocaria o
          input pelo do servidor e o cursor saltaria no meio da digitação.
          Como está fora, o valor digitado permanece e só a grade é trocada. %>
      <%= form_with url: request.path, method: :get,
                    data: { turbo_frame: "produtos-lista", loja_target: "form" } do %>
        <% request.query_parameters.except("q", "pagina").each do |chave, valor| %>
          <%= hidden_field_tag chave, valor, id: nil %>
        <% end %>
        <label class="loja-busca-wrap">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7" /><line x1="16.5" y1="16.5" x2="21" y2="21" />
          </svg>
          <input type="search" name="q" value="<%= @busca %>" class="loja-busca"
                 placeholder="Pesquisar por nome…" data-loja-target="busca"
                 data-action="input->loja#buscar" aria-label="Pesquisar produto por nome">
        </label>
      <% end %>
    </div>

    <%= render "produtos/lista" %>
  </main>

  <%= render "shared/cart_fab" %>
  <%= render "shared/footer" %>
</div>
