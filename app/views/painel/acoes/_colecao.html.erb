<%# Coleção aninhada com linhas adicionáveis/removíveis.
    Locals: `titulo`, `chave` (nome no payload), `itens`, `campos`, `vazio`.
    `campos`: [{ nome:, tipo: :text/:select/:number, rotulo:, opcoes:, opcional: }]

    O índice do name vem de um contador no template para as linhas existentes e
    de Date.now no Stimulus para as novas — só precisa ser único dentro do
    formulário; o concern normaliza o hash para lista e descarta linha vazia. %>
<fieldset class="painel-fieldset painel-colecao" data-colecao-target="grupo" data-chave="<%= chave %>">
  <legend><%= titulo %></legend>

  <div class="painel-colecao-linhas" data-colecao-target="linhas">
    <% itens.each_with_index do |item, i| %>
      <div class="painel-colecao-linha">
        <% campos.each do |campo| %>
          <label class="painel-campo">
            <span><%= campo[:rotulo] %></span>
            <% nome = "acao[#{chave}][#{i}][#{campo[:nome]}]" %>
            <%# campo virtual (não é coluna do model) traz o próprio leitor %>
            <% valor = campo[:valor] ? campo[:valor].call(item) : item.public_send(campo[:nome]) %>
            <% case campo[:tipo] %>
            <% when :select %>
              <%= select_tag nome, options_for_select(campo[:opcoes], valor),
                    include_blank: campo[:opcional] ? "—" : "escolher…", class: "painel-input compacto" %>
            <% when :number %>
              <%= number_field_tag nome, valor, class: "painel-input compacto" %>
            <% else %>
              <%= text_field_tag nome, valor, class: "painel-input" %>
            <% end %>
          </label>
        <% end %>
        <button type="button" class="painel-mini perigo" data-action="colecao#remover" aria-label="Remover linha">×</button>
      </div>
    <% end %>
  </div>

  <p class="painel-chart-vazio" data-colecao-target="vazio" <%= "hidden" if itens.any? %>>// <%= vazio %></p>

  <button type="button" class="painel-mini" data-action="colecao#adicionar">+ adicionar</button>

  <%# Linha-marcador em branco, sempre enviada. Sem ela, apagar TODAS as linhas
      não mandaria a chave `<%= chave %>` no payload — e chave ausente significa
      "não mexer" (o [] é que esvazia). O gestor removeria tudo, salvaria, e as
      linhas voltariam. Usa um campo real para sobreviver ao permit; o servidor
      descarta linha com todos os valores em branco. %>
  <%= hidden_field_tag "acao[#{chave}][zzz_marcador][#{campos.first[:nome]}]", "" %>

  <%# Molde da linha nova. <template> não é enviado nem validado pelo browser —
      o Stimulus clona e troca __IDX__ pelo índice. %>
  <template data-colecao-target="molde">
    <div class="painel-colecao-linha">
      <% campos.each do |campo| %>
        <label class="painel-campo">
          <span><%= campo[:rotulo] %></span>
          <% nome = "acao[#{chave}][__IDX__][#{campo[:nome]}]" %>
          <% case campo[:tipo] %>
          <% when :select %>
            <%= select_tag nome, options_for_select(campo[:opcoes]),
                  include_blank: campo[:opcional] ? "—" : "escolher…", class: "painel-input compacto" %>
          <% when :number %>
            <%= number_field_tag nome, nil, class: "painel-input compacto" %>
          <% else %>
            <%= text_field_tag nome, nil, class: "painel-input" %>
          <% end %>
        </label>
      <% end %>
      <button type="button" class="painel-mini perigo" data-action="colecao#remover" aria-label="Remover linha">×</button>
    </div>
  </template>
</fieldset>
