<% content_for :title, "Logs de erro — Gestão LEDS" %>
<% content_for :painel_titulo, "Logs de erro" %>

<section class="painel-secao">
  <div class="painel-panel">
    <h3 class="painel-panel-title">Erros por dia (30 dias)</h3>
    <%= render "painel/charts/linha", dados: @por_dia, cor: "var(--leds-red)", altura: 120 %>
  </div>
</section>

<div class="painel-toolbar">
  <div class="chips">
    <%= link_to painel_logs_path(rota: @rota), class: "chip #{'active' unless @severidade}" do %>
      Todos <%= painel_contador(@por_severidade.values.sum) %>
    <% end %>
    <% ErrorLog::SEVERIDADES.each do |sev| %>
      <%= link_to painel_logs_path(severidade: sev, rota: @rota),
            class: "chip #{'active' if @severidade == sev}" do %>
        <%= sev %> <%= painel_contador(@por_severidade[sev]) %>
      <% end %>
    <% end %>
  </div>

  <%# a janela de datas viaja no mesmo form da busca: a lupa submete tudo.
      `render layout:` (e não `render`) é o que faz o bloco chegar ao yield. %>
  <%= render layout: "painel/busca", locals: {
        url: painel_logs_path, campo: :rota, valor: @rota,
        placeholder: "Buscar por rota (ex.: POST /acoes)…",
        ocultos: { severidade: @severidade }
      } do %>
    <%= date_field_tag :de, params[:de], class: "painel-input compacto" %>
    <%= date_field_tag :ate, params[:ate], class: "painel-input compacto" %>
  <% end %>
</div>

<% if @logs.empty? %>
  <div class="painel-empty">
    <span class="empty-mono">// nenhum erro registrado</span>
    <p class="painel-dica">Boa notícia. Erros de servidor caem aqui automaticamente.</p>
  </div>
<% else %>
  <div class="painel-table-wrap">
    <table class="painel-table">
      <thead>
        <tr>
          <th>Quando</th>
          <th>Severidade</th>
          <th>Erro</th>
          <th>Rota</th>
          <th>Usuário</th>
          <th class="acoes"></th>
        </tr>
      </thead>
      <tbody>
        <% @logs.each do |log| %>
          <tr>
            <td class="painel-td-mono"><%= data_e_hora(log.occurred_at) %></td>
            <td><span class="painel-badge-status <%= severidade_cor(log.severidade) %>"><%= log.severidade %></span></td>
            <td class="painel-td-texto">
              <strong><%= log.error_class %></strong>
              <span class="painel-td-sub"><%= truncate(log.error_message, length: 120) %></span>
            </td>
            <td class="painel-td-mono"><%= log.rota %></td>
            <td><%= log.user&.name || "anônimo" %></td>
            <td class="acoes"><%= link_to "Detalhe", painel_log_path(log), class: "painel-mini" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
