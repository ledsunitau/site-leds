<%# Portal de Ideias (RF-IDE) — o formulário de sugestão. Não está no Figma;
    arte moderna inspirada na página de Comunidade (sem o pinguim). %>
<% content_for :title, "Sugira uma ideia — LEDS" %>

<%
  tipos = [
    { tipo: "projeto",  label: "Projeto",  grupo: "projetos", cor: "var(--leds-green)" },
    { tipo: "pesquisa", label: "Pesquisa", grupo: "projetos", cor: "var(--leds-yellow)" },
    { tipo: "evento",   label: "Evento",   grupo: "eventos",  cor: "var(--leds-blue)" },
    { tipo: "palestra", label: "Palestra", grupo: "eventos",  cor: "var(--leds-red)" }
  ]
%>

<%= render "shared/page_bg" %>

<div class="page" data-controller="ideias" data-ideias-grupo-value="<%= @grupo %>">
  <%= render "shared/navbar", active: "" %>

  <main class="content wrap ideias-page">
    <section class="ideias-hero">
      <%# ---- Esquerda: copy + formulário ---- %>
      <div class="ideias-copy">
        <span class="eyebrow blue">// suas ideias</span>
        <h1 class="leds-hero">Tem uma ideia?<br>A liga <span class="grad-text">constrói</span>.</h1>
        <p class="leds-lead ideias-lead">
          A comunidade propõe, a gestão revisa e, se a ideia virar uma ação,
          você entra como <strong>idealizador</strong>. Manda a sua.
        </p>

        <%= form_with model: @ideia, url: ideias_path, class: "ideias-form" do |f| %>
          <% if @ideia.errors.any? %>
            <div class="auth-flash alert">
              <ul class="auth-errors">
                <% @ideia.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
              </ul>
            </div>
          <% end %>

          <fieldset class="tipo-fieldset">
            <legend class="ideias-legend">O que você quer sugerir?</legend>
            <div class="tipo-grid" data-ideias-target="grid">
              <% tipos.each_with_index do |t, i| %>
                <label class="tipo-card" style="--accent:<%= t[:cor] %>" data-grupo="<%= t[:grupo] %>" data-ideias-target="card">
                  <%= f.radio_button :tipo, t[:tipo], class: "tipo-radio", required: true %>
                  <span class="tipo-ico"><%= render "ideias/tipo_icon", tipo: t[:tipo] %></span>
                  <span class="tipo-label"><%= t[:label] %></span>
                </label>
              <% end %>
            </div>
            <button type="button" class="tipo-vertodos" data-ideias-target="verTodos"
                    data-action="ideias#verTodos" hidden>ver todos os tipos</button>
          </fieldset>

          <label class="auth-field">
            <span>Título da ideia</span>
            <%= f.text_field :titulo, required: true, placeholder: "Um resumo curto da sua ideia" %>
          </label>

          <label class="auth-field">
            <span>Descrição <em class="opcional">(opcional)</em></span>
            <%= f.text_area :descricao, rows: 5, placeholder: "Conta os detalhes: o problema, quem se beneficia, como você imagina…" %>
          </label>

          <%= f.submit "Enviar ideia →", class: "btn btn-primary ideias-submit",
                data: { action: "analytics#rastrear", evento: "ideia_enviada" } %>
        <% end %>
      </div>

      <%# ---- Direita: arte (lâmpada = ideia) ---- %>
      <div class="ideias-stage" aria-hidden="true">
        <span class="stage-stars"></span>
        <span class="stage-glow ideias-glow"></span>
        <span class="stage-ring"></span>

        <span class="stage-node n1"></span>
        <span class="stage-node n2"></span>
        <span class="stage-node n3"></span>
        <span class="stage-node n4"></span>

        <span class="idea-tag it1" style="--c:var(--leds-green)"><span class="tag-dot"></span>Projeto</span>
        <span class="idea-tag it2" style="--c:var(--leds-blue)"><span class="tag-dot"></span>Evento</span>
        <span class="idea-tag it3" style="--c:var(--leds-red)"><span class="tag-dot"></span>Palestra</span>

        <svg class="ideias-bulb" viewBox="0 0 64 64" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <defs>
            <linearGradient id="bulb-grad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="10%" stop-color="rgb(0,197,91)" />
              <stop offset="50%" stop-color="rgb(29,132,245)" />
              <stop offset="90%" stop-color="rgb(248,74,84)" />
            </linearGradient>
          </defs>
          <path d="M32 8c-9.4 0-17 7.2-17 16.1 0 6.1 3.4 10.8 7.6 13.8 1.6 1.1 2.4 2.3 2.6 4.1h13.6c.2-1.8 1-3 2.6-4.1 4.2-3 7.6-7.7 7.6-13.8C49 15.2 41.4 8 32 8Z"
                stroke="url(#bulb-grad)" stroke-width="2.4" />
          <path d="M25 46h14M27 51h10M29.5 56h5" stroke="rgba(255,255,255,.55)" stroke-width="2.2" />
          <path d="M27 28l3.5-5 3 7 3.5-5" stroke="var(--leds-yellow)" stroke-width="2.2" />
        </svg>
      </div>
    </section>
  </main>

  <%= render "shared/footer" %>
</div>
