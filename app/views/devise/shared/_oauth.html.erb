<%# Login/cadastro via OAuth (RF-AUT-02). button_to = POST com CSRF, exigido
    pelo omniauth-rails_csrf_protection. turbo:false: o POST redireciona para
    fora (Google/Discord), então não pode ser interceptado pelo Turbo. %>
<div class="auth-divider"><span>ou</span></div>

<div class="auth-oauth">
  <%= button_to omniauth_authorize_path(resource_name, :google_oauth2), class: "btn-oauth", data: { turbo: false } do %>
    <svg class="oauth-ico" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path fill="#4285F4" d="M23.5 12.3c0-.9-.1-1.5-.2-2.2H12v4.1h6.5c-.1 1-.8 2.6-2.4 3.6l3.7 2.8c2.2-2 3.7-5 3.7-8.3z"/>
      <path fill="#34A853" d="M12 24c3.2 0 5.9-1.1 7.9-2.9l-3.7-2.9c-1 .7-2.4 1.2-4.2 1.2-3.2 0-5.9-2.1-6.9-5.1l-3.9 3c2 3.9 6 6.7 10.8 6.7z"/>
      <path fill="#FBBC05" d="M5.1 14.3c-.2-.7-.4-1.5-.4-2.3s.1-1.6.4-2.3l-3.9-3C.4 8.3 0 10.1 0 12s.4 3.7 1.2 5.3l3.9-3z"/>
      <path fill="#EA4335" d="M12 4.8c1.8 0 3 .8 3.7 1.4l2.7-2.7C16.9 1.9 14.5 1 12 1 7.2 1 3.2 3.8 1.2 7.7l3.9 3c1-3 3.7-5.9 6.9-5.9z"/>
    </svg>
    <span>Continuar com Google</span>
  <% end %>

  <%= button_to omniauth_authorize_path(resource_name, :discord), class: "btn-oauth", data: { turbo: false } do %>
    <svg class="oauth-ico" viewBox="0 -28.5 256 256" width="18" height="18" aria-hidden="true">
      <path fill="#5865F2" d="M216.856 16.597A208.502 208.502 0 0 0 164.042 0c-2.275 4.113-4.933 9.645-6.766 14.046-19.692-2.961-39.203-2.961-58.533 0-1.832-4.4-4.55-9.933-6.846-14.046a207.809 207.809 0 0 0-52.855 16.638C5.618 67.147-3.443 116.4 1.087 164.956c22.169 16.555 43.653 26.612 64.775 33.193a161.094 161.094 0 0 0 13.878-22.55c-7.634-2.903-14.945-6.49-21.846-10.65 1.831-1.354 3.62-2.769 5.348-4.226 42.122 19.702 87.89 19.702 129.51 0 1.75 1.457 3.538 2.872 5.347 4.227-6.921 4.18-14.253 7.767-21.888 10.669a160.783 160.783 0 0 0 13.877 22.531c21.142-6.581 42.646-16.638 64.815-33.213 5.316-56.288-9.08-105.09-38.056-148.36ZM85.474 135.09c-12.645 0-23.015-11.805-23.015-26.18s10.148-26.2 23.015-26.2c12.867 0 23.236 11.804 23.015 26.2.02 14.375-10.148 26.18-23.015 26.18Zm85.051 0c-12.645 0-23.014-11.805-23.014-26.18s10.148-26.2 23.014-26.2c12.867 0 23.236 11.804 23.015 26.2 0 14.375-10.148 26.18-23.015 26.18Z"/>
    </svg>
    <span>Continuar com Discord</span>
  <% end %>
</div>
