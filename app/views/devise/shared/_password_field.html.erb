<%# Campo de senha com botão mostrar/ocultar (olho). Locais: f, field, label,
    autocomplete, placeholder. Estado inicial oculto = olho fechado. %>
<label class="auth-field" data-controller="senha">
  <span><%= label %></span>
  <div class="auth-password">
    <%= f.password_field field, autocomplete: autocomplete, placeholder: placeholder,
          data: { senha_target: "input" } %>
    <button type="button" class="senha-toggle" data-action="senha#toggle" tabindex="-1"
            aria-label="Mostrar ou ocultar senha">
      <%# olho fechado — senha oculta (estado inicial) %>
      <svg class="olho" data-senha-target="fechado" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 9.5c2.4 2.9 5.6 4.5 9 4.5s6.6-1.6 9-4.5" />
        <line x1="5.5" y1="12.6" x2="4.3" y2="14.8" />
        <line x1="12" y1="14" x2="12" y2="16.4" />
        <line x1="18.5" y1="12.6" x2="19.7" y2="14.8" />
      </svg>
      <%# olho aberto — senha visível %>
      <svg class="olho" data-senha-target="aberto" hidden viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12z" />
        <circle cx="12" cy="12" r="2.6" />
      </svg>
    </button>
  </div>
</label>
