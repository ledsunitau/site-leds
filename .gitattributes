# See https://git-scm.com/docs/gitattributes for more about git attribute files.

# Mark the database schema as having been generated.
db/schema.rb linguist-generated
db/*structure.sql linguist-generated

# Dumps SQL são gerados dentro de containers Linux e lidos pelo psql: força LF.
db/*.sql text eol=lf

# Binstubs run inside Linux containers and CI: force LF (except Windows .cmd wrappers).
bin/* text eol=lf
bin/*.cmd text eol=crlf

# Hooks do Kamal são scripts sh. Com CRLF o shebang vira "/bin/sh\r" e o shell
# responde "bad interpreter" — mesmo motivo dos binstubs acima. Os .sample ficam
# de fora: são exemplos do gem, nunca executados.
.kamal/hooks/* text eol=lf

# Imagens de fixture (test/fixtures/files) são lidas byte a byte pelo analisador
# do Active Storage, que mede largura e altura. Qualquer conversão de fim de
# linha corrompe o PNG — explícito porque o teste que depende delas só falharia
# na máquina Windows, e com uma mensagem que não fala em CRLF.
*.png binary
*.jpg binary
*.webp binary

# Mark any vendored files as having been vendored.
vendor/* linguist-vendored
config/credentials/*.yml.enc diff=rails_credentials
config/credentials.yml.enc diff=rails_credentials
